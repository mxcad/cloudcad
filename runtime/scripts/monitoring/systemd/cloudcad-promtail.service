# 梦想网页CAD实时协同平台 Promtail systemd unit 模板（ADR-0055 §3，业务机日志采集）
# 占位符由 install-monitoring.sh 渲染替换：__USER__ / __VENDOR__ / __CONFIG_DIR__ / __POSITION_DIR__
#   __USER__         - 运行用户（默认 cloudcad）
#   __VENDOR__       - 二进制目录（runtime/vendor/monitoring/<arch>/promtail）
#   __CONFIG_DIR__   - 配置目录（/etc/cloudcad/monitoring/promtail/promtail.yml）
#   __POSITION_DIR__ - 续传位置目录（/var/lib/promtail）

[Unit]
Description=梦想网页CAD实时协同平台 Promtail (log shipper to Loki)
Documentation=https://github.com/mxcad/cloudcad
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
ExecStart=__VENDOR__/promtail \
  -config.file=__CONFIG_DIR__/promtail/promtail.yml
Restart=on-failure
RestartSec=5s
# 目录 0750 / 文件 0640（与业务进程 umask 027 一致）
UMask=027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__POSITION_DIR__
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
