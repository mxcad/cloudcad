{
  "name": "@cloudcad/db",
  "version": "0.1.0",
  "private": true,
  "description": "共享 Prisma Client — schema 单一源 + generated client 导出（PrismaClient + 模型/枚举类型）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma/schema.prisma"
  ],
  "scripts": {
    "db:generate": "node scripts/clean-dir.js src/generated/client && prisma generate",
    "build": "pnpm db:generate && pnpm clean && tsc",
    "type-check": "tsc --noEmit",
    "clean": "node scripts/clean-dir.js dist"
  },
  "dependencies": {
    "@prisma/client": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "dotenv": "^17.4.2",
    "prisma": "^7.1.0",
    "typescript": "~5.9.3"
  }
}
