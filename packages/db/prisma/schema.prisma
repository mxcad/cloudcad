generator client {
  provider        = "prisma-client"
  output          = "../src/generated/client"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

model User {
  id                   String           @id @default(cuid())
  email                String?          @unique
  /// PII 字段级加密（#417 等保 8.1.4.8）：email 的 AES-256-GCM 密文（enc:v1 格式）；明文列保留至收缩阶段
  emailEnc             String?
  /// PII 归一化索引（#417）：HMAC-SHA256(归一化 email) hex，查询走此列等值匹配
  emailHmac            String?          @unique
  username             String           @unique
  password             String?
  nickname             String?
  avatar               String?
  roleId               String
  status               UserStatus       @default(INACTIVE)
  emailVerified        Boolean          @default(false)
  emailVerifiedAt      DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  phone                String?          @unique
  /// PII 字段级加密（#417 等保 8.1.4.8）：phone 的 AES-256-GCM 密文（enc:v1 格式）；明文列保留至收缩阶段
  phoneEnc             String?
  /// PII 归一化索引（#417）：HMAC-SHA256(归一化 phone) hex，查询走此列等值匹配
  phoneHmac            String?          @unique
  phoneVerified        Boolean          @default(false)
  phoneVerifiedAt      DateTime?
  wechatId             String?          @unique
  provider             String           @default("LOCAL")
  oldSiteUserId        String?          @unique
  deletedAt            DateTime?
  /// 注销来源：'SELF'=用户自助注销（冷静期内登录可自动恢复），'ADMIN'=管理员软删（不自动恢复）；null=存量数据/未注销
  deactivatedBy        String?
  lastUsernameChangeAt DateTime?
  usernameChangeCount  Int              @default(0)
  /// 口令最后修改时间（#416 等保 8.1.4.1）：全员维护（注册/改密/重置时写入）；
  /// 仅 ADMIN 角色据此做 180 天到期强制改密 + 首登未改密判定（null=初始管理员首登未改密）
  passwordChangedAt    DateTime?
  /// TOTP 双因素密钥（AES-256-GCM 密文，格式 enc:v1:<iv>:<ciphertext>:<tag>）；null=未绑定
  totpSecret           String?
  /// TOTP 双因素启用标志（ADMIN 角色生效；启用后管理员登录入口必须通过动态码校验）
  totpEnabled          Boolean          @default(false)
  auditLogs            AuditLog[]
  ownedNodes           FileSystemNode[] @relation("NodeOwner")
  projectMembers       ProjectMember[]
  role                 Role             @relation(fields: [roleId], references: [id])
  refreshTokens        RefreshToken[]
  fileShares           FileShare[]
  membership           UserMembership?
  paymentOrders        PaymentOrder[]
  refundApplications   RefundApplication[]
  refundReviews        RefundApplication[] @relation("RefundReviewer")
  feedbacks            Feedback[]
  feedbackRewards      FeedbackReward[]
  feedbackAttachments  FeedbackAttachment[]

  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String
  description String?
  parentId    String?
  category    RoleCategory     @default(SYSTEM)
  level       Int              @default(0)
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  parent      Role?            @relation("RoleHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Role[]           @relation("RoleHierarchy")
  users       User[]

  @@index([parentId])
  @@index([category])
  @@index([level])
  @@unique([name])
  @@map("roles")
}

model RolePermission {
  id         String     @id @default(cuid())
  roleId     String
  permission Permission
  createdAt  DateTime   @default(now())
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@map("role_permissions")
}

enum NodeType {
  FILE
  FOLDER
  PROJECT
  PERSONAL_SPACE
  LIBRARY_DRAWING
  LIBRARY_BLOCK
}

// Note: This model has 3 extra GIN indexes that are NOT declared in schema.prisma
// because Prisma does not support them (GIN with tsvector / gin_trgm_ops).
// They are created by migration 20260729060604_restore_search_indexes and
// will show as drift in `prisma migrate diff` — ignore or preserve them.
//   - idx_file_system_nodes_search_vector       (GIN on "searchVector")
//   - idx_file_system_nodes_name_trgm            (GIN on name gin_trgm_ops)
//   - idx_file_system_nodes_description_trgm     (GIN on description gin_trgm_ops)
model FileSystemNode {
  id                             String           @id @default(cuid())
  name                           String
  nodeType                       NodeType
  parentId                       String?
  originalName                   String?
  path                           String?
  size                           Int?
  mimeType                       String?
  extension                      String?
  fileStatus                     FileStatus?  @default(COMPLETED)
  fileHash                       String?
  taskId                         String?
  description                    String?
  projectStatus                  ProjectStatus?
  /// 出向策略：本项目文件 → 其他项目（仅 PROJECT 根）
  transferOutToProject           CrossProjectTransferMode? @default(ALL)
  /// 出向策略：本项目文件 → 个人空间（防图纸私有化，默认禁止）
  transferOutToPersonalSpace     CrossProjectTransferMode? @default(NONE)
  /// 出向策略：本项目文件 → 公共资源库（发布，默认仅复制）
  transferOutToLibrary           CrossProjectTransferMode? @default(COPY_ONLY)
  /// 入向策略：其他项目文件 → 本项目
  transferInFromProject          CrossProjectTransferMode? @default(ALL)
  /// 入向策略：个人空间文件 → 本项目
  transferInFromPersonalSpace    CrossProjectTransferMode? @default(ALL)
  /// 入向策略：公共资源库文件 → 本项目
  transferInFromLibrary          CrossProjectTransferMode? @default(ALL)
  ownerId                        String
  createdAt                      DateTime         @default(now())
  updatedAt                      DateTime         @updatedAt
  deletedAt                      DateTime?
  deletedByCascade               Boolean          @default(false)
  deletedFromStorage             DateTime?
  projectId                      String?
  totalSize                      Float?           @default(0)
  searchVector                   Unsupported("tsvector")?
  owner                          User             @relation("NodeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  parent                         FileSystemNode?  @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children                       FileSystemNode[] @relation("NodeHierarchy")
  project                        FileSystemNode?  @relation("NodeProject", fields: [projectId], references: [id], onDelete: Cascade)
  files                          FileSystemNode[] @relation("NodeProject")
  projectMembers                 ProjectMember[]
  projectRoles                   ProjectRole[]

  @@index([parentId])
  @@index([ownerId])
  @@index([nodeType])
  @@index([deletedAt])
  @@index([projectId])
  @@index([fileStatus])
  @@index([projectId, deletedAt, nodeType, updatedAt], name: "idx_project_search")
  @@index([nodeType, deletedAt, updatedAt], name: "idx_library_search")
  @@map("file_system_nodes")
}

model ProjectRole {
  id          String                  @id @default(cuid())
  projectId   String?
  name        String
  description String?
  isSystem    Boolean                 @default(false)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  members     ProjectMember[]
  permissions ProjectRolePermission[]
  project     FileSystemNode?         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
  @@map("project_roles")
}

model ProjectRolePermission {
  id            String            @id @default(cuid())
  projectRoleId String
  permission    ProjectPermission
  createdAt     DateTime          @default(now())
  projectRole   ProjectRole       @relation(fields: [projectRoleId], references: [id], onDelete: Cascade)

  @@unique([projectRoleId, permission])
  @@map("project_role_permissions")
}

model ProjectMember {
  id            String         @id @default(cuid())
  projectId     String
  userId        String
  projectRoleId String
  createdAt     DateTime       @default(now())
  project       FileSystemNode @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectRole   ProjectRole    @relation(fields: [projectRoleId], references: [id])
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectRoleId])
  @@index([projectId])
  @@map("project_members")
}

model Asset {
  id          String      @id @default(cuid())
  name        String
  description String?
  category    String
  path        String
  thumbnail   String?
  size        Int
  mimeType    String
  status      AssetStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("assets")
}

model Font {
  id        String     @id @default(cuid())
  name      String
  family    String
  path      String
  size      Int
  status    FontStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("fonts")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  clientId  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id           String       @id @default(cuid())
  action       AuditAction
  resourceType ResourceType
  resourceId   String?
  // 项目维度（系统级操作可空），#207 阶段 1（ADR-0045）
  projectId    String?
  // 名称快照：记录时存当时的文件/项目/用户名称，资源删除后记录依然可读
  resourceName String?
  // 结构化参数 JSON（替代 details blob），如 { targetUserId, fromRole, toRole }
  params       Json?
  userId       String
  ipAddress    String?
  userAgent    String?
  success      Boolean
  errorMessage String?
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model UploadSession {
  id            String   @id @default(cuid())
  uploadId      String   @unique
  storageKey    String
  fileName      String
  fileSize      Int
  fileId        String?
  projectId     String?
  parentId      String?
  ownerId       String
  status        String   @default("INITIATED")
  totalParts    Int?
  uploadedParts Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("upload_sessions")
}

model RuntimeConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String
  category    String
  description String?
  isPublic    Boolean  @default(false)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("runtime_configs")
}

model RuntimeConfigLog {
  id         String   @id @default(cuid())
  key        String
  oldValue   String?
  newValue   String
  operatorId String?
  operatorIp String?
  createdAt  DateTime @default(now())

  @@index([key])
  @@index([createdAt])
  @@map("runtime_config_logs")
}

/// 通道验证结论强度（ADR-0082 D4 修订）：
/// PROBE = 无副作用探测通过；END_TO_END = 真实发送/往返确认通过；
/// SIMULATED = mock 模式，未接触任何外部系统，永不满足开启门禁。
enum ChannelVerdict {
  PROBE
  END_TO_END
  SIMULATED
}

/// 通道验证记录（ADR-0082 D4）：通道开关须「配置完整 + 通道测试通过」才可开启；
/// 该通道任一配置项变更即删除记录（比配置哈希更简单可靠）。
/// testedBy 为测试操作者用户 ID（与 runtime_config_logs.operatorId 同口径，不设外键）
///
/// verdict 记录测试动作如实声明的结论强度——旧实现把「什么都没接触就报通过」
/// （mock）与真实探测、端到端真发压成同一个 `ok` bit，三者写同一条记录、被开启
/// 门禁同等采信。默认 PROBE：早于本列的存量记录按「探测通过」采信，等价于升级前
/// 既有行为，升级不阻断已验证部署；通道配置一变记录即删除，存量记录自然过期。
model ChannelVerification {
  id         String         @id @default(cuid())
  channel    String         @unique
  verifiedAt DateTime       @default(now())
  testedBy   String
  testedByIp String?
  verdict    ChannelVerdict @default(PROBE)
  createdAt  DateTime       @default(now())

  @@map("channel_verifications")
}

enum BlacklistSource {
  MANUAL
  AUTO
}

model IpBlacklistEntry {
  id        String          @id @default(cuid())
  ip        String
  source    BlacklistSource
  reason    String
  createdBy String
  createdAt DateTime        @default(now())
  expiresAt DateTime?

  @@index([ip])
  @@index([expiresAt])
  @@map("ip_blacklist_entries")
}

/// 管理员登录 IP 白名单（DB 配置通道；与服务器本地文件白名单取并集生效）
model IpWhitelistEntry {
  id        String          @id @default(cuid())
  ip        String
  source    BlacklistSource
  reason    String
  createdBy String
  createdAt DateTime        @default(now())
  expiresAt DateTime?

  @@index([ip])
  @@index([expiresAt])
  @@map("ip_whitelist_entries")
}

/// 高危接口访问尝试记录（如管理员登录被拒）：认证前无合法 userId，故不关联 User，
/// 独立存储供安全回溯 / 页面聚合展示 / 一键拉白拉黑。写库失败不阻塞登录流程。
model SecurityAccessAttempt {
  id         String                 @id @default(cuid())
  /// 归一化后的客户端 IP（normalizeStoredIp 结果）
  ip         String
  /// 被访问的高危接口（如 /api/v1/admin/auth/login）
  endpoint   String
  /// 拒绝原因（ip_not_allowed / user_not_found / account_unavailable / not_admin / bad_password / blacklisted）
  reason     SecurityAttemptReason
  /// 尝试使用的账号（可能为扫描器瞎填，可为空）
  account    String?
  userAgent  String?
  createdAt  DateTime               @default(now())

  @@index([ip])
  @@index([createdAt])
  @@index([endpoint])
  @@map("security_access_attempts")
}

enum SecurityAttemptReason {
  ip_not_allowed
  user_not_found
  account_unavailable
  not_admin
  bad_password
  blacklisted
  /// TOTP 动态码缺失（#415：已启用 TOTP 的管理员登录未带码）
  mfa_code_missing
  /// TOTP 动态码错误（#415：已启用 TOTP 的管理员登录码校验失败）
  mfa_code_invalid
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

