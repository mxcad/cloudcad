  SYSTEM_USER_READ
  SYSTEM_USER_CREATE
  SYSTEM_USER_UPDATE
  SYSTEM_USER_DELETE
  SYSTEM_USER_MEMBERSHIP_MANAGE
  SYSTEM_ROLE_READ
  SYSTEM_ROLE_CREATE
  SYSTEM_ROLE_UPDATE
  SYSTEM_ROLE_DELETE
  SYSTEM_ROLE_PERMISSION_MANAGE
  SYSTEM_FONT_READ
  SYSTEM_FONT_UPLOAD
  SYSTEM_FONT_DELETE
  SYSTEM_FONT_DOWNLOAD
  SYSTEM_ADMIN
  SYSTEM_BILLING_READ
  SYSTEM_BILLING_WRITE
  SYSTEM_MONITOR
  SYSTEM_CONFIG_READ
  SYSTEM_CONFIG_WRITE
  SYSTEM_IP_BLACKLIST_MANAGE
  SYSTEM_IP_WHITELIST_MANAGE
  LIBRARY_DRAWING_MANAGE
  LIBRARY_BLOCK_MANAGE
  PROJECT_CREATE
}

enum ProjectPermission {
  PROJECT_UPDATE
  PROJECT_DELETE
  PROJECT_MEMBER_MANAGE
  PROJECT_MEMBER_ASSIGN
  PROJECT_TRANSFER
  PROJECT_TRANSFER_MANAGE
  PROJECT_ROLE_MANAGE
  PROJECT_ROLE_PERMISSION_MANAGE
  FILE_CREATE
  FILE_UPLOAD
  FILE_OPEN
  FILE_EDIT
  FILE_DELETE
  FILE_TRASH_MANAGE
  FILE_DOWNLOAD
  FILE_SHARE
  FILE_MOVE
  FILE_COPY
  CAD_SAVE
  CAD_EXTERNAL_REFERENCE
  VERSION_READ
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

/// 跨项目转移模式（项目根节点的出向/入向策略；仅 PROJECT 根使用）
enum CrossProjectTransferMode {
  NONE
  COPY_ONLY
  MOVE_ONLY
  ALL
}

enum FileStatus {
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
  DELETED
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum FontStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum AuditAction {
  PERMISSION_GRANT
  PERMISSION_REVOKE
  ROLE_CREATE
  ROLE_UPDATE
  ROLE_DELETE
  USER_LOGIN
  USER_LOGOUT
  USER_REGISTER
  USER_VERIFY_EMAIL
  USER_BIND_EMAIL
  USER_UNBIND_EMAIL
  USER_BIND_PHONE
  USER_UNBIND_PHONE
  USER_REBIND_EMAIL
  USER_REBIND_PHONE
  USER_BIND_WECHAT
  USER_UNBIND_WECHAT
  USER_CHANGE_PASSWORD
  USER_DEACTIVATE
  PROJECT_CREATE
  PROJECT_DELETE
  PROJECT_UPDATE
  PROJECT_TRANSFER
  FILE_UPLOAD
  FILE_DOWNLOAD
  FILE_DELETE
  FILE_SHARE
  ADD_MEMBER
  UPDATE_MEMBER
  REMOVE_MEMBER
  TRANSFER_OWNERSHIP
  IP_BLACKLIST_ADD
  IP_BLACKLIST_REMOVE
  IP_WHITELIST_ADD
  IP_WHITELIST_REMOVE
  ADMIN_LOGIN
  ALERT_RESOLVE
  AUDIT_EXPORT
  FILE_CREATE
  FILE_UPDATE
  FOLDER_CREATE
  NODE_RENAME
  NODE_MOVE
  NODE_COPY
  NODE_RESTORE
  REFUND_APPLY
  REFUND_APPROVE
  REFUND_REJECT
}

enum ResourceType {
  SYSTEM
  USER
  ROLE
  PERMISSION
  PROJECT
  FILE
  FOLDER
  ALERT
  IpBlacklistEntry
  IpWhitelistEntry
}

enum RoleCategory {
  SYSTEM
  PROJECT
  CUSTOM
}

model FileShare {
  id        String    @id @default(cuid())
  fileId    String
  token     String    @unique @default(nanoid(16))
  createdBy String
  expiresAt DateTime?
  usedCount Int       @default(0)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator User @relation(fields: [createdBy], references: [id])

  @@index([fileId])
  @@index([token])
  @@index([createdBy])
  @@map("file_shares")
}

enum OrderStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CLOSED
  TIMEOUT
}

model PaymentOrder {
  id              String        @id @default(cuid())
  orderNo         String        @unique
  userId          String
  vipTierId       String?
  months          Int?
  amount          Int
  status          OrderStatus   @default(PENDING)
  gateway         String        @default("wechat_pay")
  gatewayOrderId  String?
  tradeType       String?
  gatewayPaidId   String?
  description     String?
  paidAt          DateTime?
  failedAt        DateTime?
  closedAt        DateTime?
  refundedAt      DateTime?
  refundReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user               User                 @relation(fields: [userId], references: [id])
  vipTier            VipTier?             @relation(fields: [vipTierId], references: [id])
  refundApplications RefundApplication[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@map("payment_orders")
}

enum RefundApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model RefundApplication {
  id         String                  @id @default(cuid())
  orderId    String
  userId     String
  amount     Int
  reason     String
  status     RefundApplicationStatus @default(PENDING)
  reviewerId String?
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  order PaymentOrder @relation(fields: [orderId], references: [id])
  user  User         @relation(fields: [userId], references: [id])
  reviewer User?     @relation("RefundReviewer", fields: [reviewerId], references: [id])

  @@index([orderId, status])
  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  // 与手写 migration 20260814_refund_audit_actions 的 refund_applications_reviewerId_idx 对应，避免 migrate dev 漂移
  @@index([reviewerId])
  // 部分唯一索引（手写 migration 20260814000000_add_refund_pending_unique）：
  // 同一订单最多一条 PENDING 申请，防并发重复申请
  // CREATE UNIQUE INDEX "refund_applications_orderId_pending_idx" ON "refund_applications"("order_id") WHERE "status" = 'PENDING';
  @@map("refund_applications")
}

model UserMembership {
  id        String   @id @default(cuid())
  userId    String   @unique
  tierLevel Int      @default(0)
  expiresAt DateTime?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  @@map("user_memberships")
}

enum PolicyType {
  TIME
  IP
  DEVICE
}

enum BatchJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model BatchDownloadJob {
  id             String         @id @default(cuid())
  userId         String
  projectId      String?
  status         BatchJobStatus @default(PENDING)
  fileList       Json
  totalCount     Int
  completedCount Int            @default(0)
  errorCount     Int            @default(0)
  zipPath        String?
  zipSize        Int?
  errors         Json?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?
  expiresAt      DateTime?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("batch_download_jobs")
}

model VipTier {
  id               String        @id @default(cuid())
  level            Int           @unique
  name             String
  baseMonthlyPrice Int
  isActive         Boolean       @default(true)
  configs          Json          @default("{}")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  orders           PaymentOrder[]

  @@map("vip_tiers")
}

model DurationPricing {
  id            String   @id @default(cuid())
  months        Int      @unique
  multiplierBps Int
  label         String
  isActive      Boolean  @default(true)
  sortOrder     Int
  createdAt     DateTime @default(now())

  @@map("duration_pricings")
}

model ConfigKeyRegistry {
  id           String   @id @default(cuid())
  key          String   @unique
  type         String
  label        String
  defaultValue Json?
  description  String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("config_key_registry")
}

enum AlertLevel {
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  RESOLVED
}

model AlertRecord {
  id         String      @id @default(cuid())
  source     String
  messageKey String
  level      AlertLevel
  message    String
  detail     Json?
  status     AlertStatus @default(OPEN)
  resolvedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([source, messageKey, status])
  @@index([status, level])
  @@index([createdAt])
  @@map("alert_records")
}

enum TaskRunStatus {
  SUCCESS
  FAILED
}

enum TaskRunTrigger {
  SCHEDULED
  MANUAL
}

model TaskRun {
  id           String         @id @default(cuid())
  taskName     String
  status       TaskRunStatus
  startedAt    DateTime       @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  errorSummary String?
  trigger      TaskRunTrigger @default(SCHEDULED)
  triggeredBy  String?
  createdAt    DateTime       @default(now())

  @@index([taskName, startedAt])
  @@index([status, startedAt])
  @@index([startedAt])
  @@map("task_runs")
}
