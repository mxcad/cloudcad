{
  "name": "frontend_mobile",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev-force": "vite --host --force",
    "build": "vite build",
    "build:en": "pnpm setEnI18n && pnpm i18nCompile && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "clean": "rimraf dist",
    "iconReplace": "node iconReplace.js",
    "setEnI18n": "voerkai18n init . -lngs en-US -d en-US -r",
    "setDefaultI18n": "voerkai18n init . -lngs zh-CN en-US ko-KR zh-TW -d zh-CN -r",
    "i18nInit": "pnpm setDefaultI18n",
    "i18n:init": "voerkai18n init",
    "i18n:extract": "voerkai18n extract",
    "i18nExtract": "voerkai18n extract -D -f ts,vue,json -e !dist,!.vscode,!doc,!patches,!public,!scripts",
    "i18n:compile": "voerkai18n compile -t",
    "i18nCompile": "voerkai18n compile -t",
    "i18nAutoTranslate": "voerkai18n translate --api baidu --provider baidu",
    "i18nAutoTranslateAi": "voerkai18n translate --api qwen",
    "i18n": "pnpm i18n:extract && pnpm i18nAutoTranslate && pnpm i18n:compile",
    "i18nAnnotationTranslation": "node scripts/i18n/i18nAnnotationTranslation",
    "i18nSourceCodeSubstitution-ZH": "node scripts/i18n/i18nSourceCodeSubstitution.js -d zh-CN",
    "i18nSourceCodeSubstitution-EN": "node scripts/i18n/i18nSourceCodeSubstitution.js -d en-US",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": ""
  },
  "voerkai18n": {
    "namespaces": {
      "default": "messages"
    },
    "patterns": [
      "src/**/*.ts",
      "src/**/*.vue",
      "src/**/*.tsx",
      "src/**/*.json",
      "!src/**/*.d.ts",
      "!dist",
      "!.vscode",
      "!public",
      "!scripts",
      "!node_modules"
    ]
  },
  "dependencies": {
    "@better-scroll/core": "^2.5.1",
    "@better-scroll/observe-dom": "^2.5.1",
    "@better-scroll/observe-image": "^2.5.1",
    "@cloudcad/api-sdk": "workspace:*",
    "@jaames/iro": "^5.5.2",
    "@vant/touch-emulator": "^1.4.0",
    "@varlet/touch-emulator": "^2.9.3",
    "@voerkai18n/formatters": "^3.0.22",
    "@voerkai18n/runtime": "^3.0.12",
    "@voerkai18n/vue": "^3.0.12",
    "@vueuse/core": "^10.9.0",
    "axios": "^1.13.2",
    "latest": "^0.2.0",
    "mxcad": "^1.0.393",
    "mxdraw": "^0.1.383",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "spark-md5": "^3.0.2",
    "vant": "^4.9.24",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/spark-md5": "^3.0.5",
    "@vitejs/plugin-legacy": "1.8.2",
    "@vitejs/plugin-vue": "^4.1.0",
    "@vitejs/plugin-vue-jsx": "^3.0.1",
    "@voerkai18n/cli": "3.0.12",
    "@voerkai18n/plugins": "3.0.12",
    "happy-dom": "^14.7.1",
    "lib-flexible": "^0.3.2",
    "node-html-parser": "^6.1.5",
    "patch-package": "^8.0.0",
    "postcss-pxtorem": "^6.0.0",
    "sass": "^1.60.0",
    "terser": "5.14.2",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^32.1.0",
    "vconsole": "^3.15.0",
    "vite": "^4.2.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vconsole": "^1.3.1",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.0"
  }
}
