# CloudCAD Backend 环境配置
# 复制此文件为 .env 并修改配置
# copy .env.example .env

# ============================================
# 应用配置
# ============================================

# 后端 API 服务端口
PORT=3001

# 运行环境 (development/production)
NODE_ENV=production

# 前端页面访问 URL
FRONTEND_URL=http://localhost:3000

# 前端静态服务端口
FRONTEND_PORT=3000

# 配置中心服务端口
CONFIG_SERVICE_PORT=3002

# 协同服务地址
COOPERATE_URL=http://localhost:3091

# 自定义认证实现模块路径（可选）
# 为空则使用内置默认认证实现（auth/impl/index.ts 的 createDefaultAuthProviders）
# IMPL=true 或 IMPL=1 → 加载私有包默认路径 packages/impl-mx/dist
# 其他值 → 任意绝对/相对路径，从该模块加载 createAuthProviders()/createRealProviders() 导出的 Provider
# 例如: IMPL=./dist/auth/impl-custom/index.js
# IMPL=

# ============================================
# 安全配置
# ============================================

# CORS 允许的源 (生产环境必须设置，逗号分隔多个域名)
# CORS_ORIGINS=https://app.cloudcad.com,https://admin.cloudcad.com

# ============================================
# 数据库配置
# ============================================

# Prisma 连接字符串 (必须配置)
# 本地开发: postgresql://postgres:password@localhost:5432/cloudcad
# Docker 部署: postgresql://postgres:your-secure-password-here@postgres:5432/cloudcad
DATABASE_URL=postgresql://postgres:password@localhost:5432/cloudcad

# 数据库主机地址
DB_HOST=localhost

# 数据库端口
DB_PORT=5432

# 数据库用户名
DB_USERNAME=postgres

# 数据库密码
DB_PASSWORD=password

# 数据库名称
DB_DATABASE=cloudcad

# 是否启用 SSL 连接
DB_SSL=false

# 最大连接数
DB_MAX_CONNECTIONS=20

# 连接超时时间 (毫秒)
DB_CONNECTION_TIMEOUT=30000

# 空闲连接超时时间 (毫秒)
DB_IDLE_TIMEOUT=30000

# ============================================
# Redis 配置
# ============================================

# Redis 主机地址
REDIS_HOST=localhost

# Redis 端口
REDIS_PORT=6379

# Redis 密码 (可选)
REDIS_PASSWORD=

# Redis 数据库编号
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100
REDIS_CONNECT_TIMEOUT=10000

# ============================================
# JWT 配置
# ============================================

# JWT 密钥 (生产环境必须修改!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-key-secret-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Session 配置
# ============================================

# Session 密钥 (可选，默认使用 JWT_SECRET)
SESSION_SECRET=
# Session 有效期 (毫秒，默认 24 小时)
SESSION_MAX_AGE=86400000
# Session Cookie 名称
SESSION_NAME=mxcad.sid
# Session Cookie 域名 (可选，生产环境使用，例如: .yourdomain.com)
# SESSION_COOKIE_DOMAIN=.yourdomain.com
# Session Cookie sameSite 策略 (可选，默认: lax，生产环境建议: none)
# SESSION_COOKIE_SAME_SITE=none
# Session Cookie secure 标志 (可选，默认 auto，按请求协议自适应：
#   auto/http 请求不带 Secure、https 请求带 Secure，适配局域网 http 离线部署；
#   如需强制开启/关闭 Secure，显式设置为 true 或 false 即可覆盖协议判断)
SESSION_COOKIE_SECURE=auto

# ============================================
# 存储路径配置
# ============================================
# 重要: 建议使用绝对路径，相对路径是相对于当前整个项目的根目录,而非后端项目目录
# Windows 示例: D:/web/MxCADOnline/cloudcad/data/files
# Linux 示例: /var/www/cloudcad/data/files
# 
# 默认所有数据目录在 data/ 下，便于备份和迁移

# 文件数据目录 (存储 CAD 文件、缩略图等)
FILES_DATA_PATH=data/files

# 头像存储目录 (默认在文件数据目录下)
AVATAR_PATH=data/files/avatars

# MX 仓库目录
MX_REPO_PATH=data/mx-repo

# 单目录最大节点数 (默认 300000)
FILES_NODE_LIMIT=300000

# 用户存储清理延迟天数 (默认 30 天)
USER_CLEANUP_DELAY_DAYS=30

# 是否启用用户清理任务 (true/false，默认 true)
ENABLE_USER_CLEANUP=true

# 用户清理任务 Cron 表达式 (默认每天凌晨4点)
USER_CLEANUP_CRON=0 4 * * *

# ============================================
# 存储清理配置（已迁移到运行时配置，可在管理页动态修改）
# ============================================

# MX 忽略的文件模式 (逗号分隔)
# 这些文件不会被提交到 MX 版本控制
MX_IGNORE_PATTERNS=*.mxweb,*.dwg,*.dxf,*.json,*.jpg

# ============================================
# 上传配置
# ============================================
# 注意: 文件大小限制 (maxFileSize) 已迁移到运行时配置系统，可在管理界面动态修改
# Multer 中间件层使用固定上限值 (500MB)，业务层使用运行时配置进行精确限制
# 其他上传配置仍需要在此处设置

# 允许的文件类型 (逗号分隔)
UPLOAD_ALLOWED_TYPES=.dwg,.dxf,.pdf,.png,.jpg,.jpeg
# 单次上传最大文件数
UPLOAD_MAX_FILES=10
# 允许的 CAD 文件扩展名 (用于严格验证)
UPLOAD_ALLOWED_EXTENSIONS=.dwg,.dxf
# 禁止上传的文件扩展名
UPLOAD_BLOCKED_EXTENSIONS=.exe,.bat,.sh,.cmd,.ps1
# 文件转换并发数 (CPU 密集型，建议不超过 CPU 核心数)
UPLOAD_MAX_CONCURRENT=3
# 分片上传并发数 (I/O 密集型，可以较高)
UPLOAD_CHUNK_MAX_CONCURRENT=5

# ============================================
# MxCAD 转换服务配置
# ============================================
# 重要: 路径必须使用绝对路径或确保相对路径能正确解析

# MxCAD 转换程序路径（不设置时按平台自动选择）
#   Linux:   runtime/linux/mxcad/mxcadassembly
#   Windows: runtime/windows/mxcad/mxcadassembly.exe
# ⚠️ 跨平台复制 .env 时无需删除此配置：Linux 上配置了 .exe 路径会自动回退到平台默认路径，
#    不会导致转换命令报 "/bin/sh: not found"(exit 127)。
# MXCAD_ASSEMBLY_PATH=runtime/windows/mxcad/mxcadassembly.exe

# 上传临时目录
MXCAD_UPLOAD_PATH=data/uploads

# 临时文件目录
MXCAD_TEMP_PATH=data/temp

# 转换失败调试信息保存目录（按 nodeId 子目录组织）
# 转换失败时会自动保存源文件、转换命令和完整日志到此目录，用于排查转换程序问题
MXCAD_DEBUG_PATH=data/debug

# 字体目录 (可选)
# MXCAD_FONTS_PATH=runtime/windows/mxcad/fonts

# 前端字体目录 (可选)
# 用于存储前端 Web 显示所需的字体文件
# 默认指向 packages/frontend/dist/mxcadAppAssets/fonts
FRONTEND_FONTS_PATH=packages/frontend/dist/mxcadAppAssets/fonts

MXCAD_FILE_EXT=.mxweb
MXCAD_COMPRESSION=true

# ============================================
# 弹性转换架构配置 (PRD #125 / ADR-0014/0015/0016)
# 三种部署模式: embedded (默认) / standalone / cloud-faas
# 相关独立服务: packages/conversion-service (3100) / packages/storage-service (3200)
# ============================================

# 存储部署模式: embedded | standalone
# embedded = 后端进程内置（默认，零外部依赖）
# standalone = 独立 storage-service，后端通过 HTTP 调用
STORAGE_MODE=embedded

# standalone 模式下 storage-service 地址
STORAGE_SERVICE_URL=http://localhost:3200

# 转换执行模式: process-pool | conversion-service | cloud-faas
# process-pool = 嵌入式进程池（默认）
# conversion-service = 独立 conversion-service 服务
# cloud-faas = 云端函数计算
FUNCTION_EXECUTOR=process-pool

# conversion-service 模式下 conversion-service 服务地址
CONVERSION_SERVICE_URL=http://localhost:3100

# conversion-service 批量转换等管理路由的共享密钥（与 conversion-service 端 CONVERSION_SERVICE_SECRET 保持一致）
# 不配置则 conversion-service 端跳过校验（仅内网/本地开发）
CONVERSION_SERVICE_SECRET=

# conversion-service 模式下任务状态轮询间隔/超时 (毫秒)
CONVERSION_SERVICE_POLL_INTERVAL=1000
CONVERSION_SERVICE_POLL_TIMEOUT=300000

# Cloud FaaS 供应商: huawei | aliyun | aws
CLOUD_FAAS_PROVIDER=huawei

# 华为 FunctionGraph (APIG HTTP 触发器)
HUAWEI_FUNCTIONGRAPH_ENDPOINT=
HUAWEI_AK=
HUAWEI_SK=

# 阿里云函数计算 (HTTP 触发器)
ALIYUN_FC_ENDPOINT=
ALIYUN_AK=
ALIYUN_SK=

# AWS Lambda (Function URL 触发器)
AWS_LAMBDA_ENDPOINT=
AWS_AK=
AWS_SK=
AWS_REGION=us-east-1

# conversion-service 队列驱动: local | redis
QUEUE_DRIVER=local

# conversion-service 工作池按积压自动扩容（默认开启）
WORKER_POOL_AUTO_SCALE=true
# 单级并发上限倍率与全局并发上限
WORKER_POOL_MAX_MULTIPLIER=2
WORKER_POOL_MAX_CONCURRENT=8
# 触发扩容的积压阈值（相对基准并发）与持续窗口
WORKER_POOL_BACKLOG_THRESHOLD=2
WORKER_POOL_BACKLOG_WINDOW_MS=2000

# 批量下载转换委托 conversion-service（默认 false 保持进程内转换）
BATCH_DOWNLOAD_DELEGATE_WORKFLOW=false
# 委托模式轮询间隔/超时 (毫秒)
BATCH_DOWNLOAD_WORKFLOW_POLL_INTERVAL_MS=1500
BATCH_DOWNLOAD_WORKFLOW_TIMEOUT_MS=600000

# 独立服务监听端口
CONVERSION_SERVICE_PORT=3100
STORAGE_SERVICE_PORT=3200

# storage-service 上传令牌校验共享密钥 (standalone 模式必须与后端 JWT_SECRET 不同但保持一致)
# 用于签发/校验预签名上传 JWT，storage-service 仅校验不查库
BACKEND_JWT_SECRET=

# storage-service L3 热文件缓存配置
# 最大缓存条目数
STORAGE_CACHE_MAX_SIZE=100
# 单文件缓存上限 (字节，默认 10MB)
STORAGE_CACHE_MAX_FILE_SIZE=10485760
# 缓存 TTL (毫秒，默认 5 分钟)
STORAGE_CACHE_TTL_MS=300000

# storage-service 多节点路由表路径 (默认 config/storage-routing.json)
# STORAGE_ROUTING_TABLE=config/storage-routing.json

# ============================================
# 缓存配置
# ============================================

# L2 缓存默认 TTL (秒，默认 30 分钟)
CACHE_L2_DEFAULT_TTL=1800
# 缓存版本最大有效期 (毫秒，默认 1 小时)
CACHE_VERSION_MAX_AGE=3600000

# ============================================
# 缓存 TTL 配置 (秒)
# ============================================

# 验证码有效期 (默认 15 分钟)
CACHE_TTL_VERIFICATION_CODE=900
# 验证码限流周期 (默认 1 分钟)
CACHE_TTL_VERIFICATION_RATE_LIMIT=60
# Token 黑名单有效期 (默认 7 天)
CACHE_TTL_TOKEN_BLACKLIST=604800
# 缓存版本有效期 (默认 24 小时)
CACHE_TTL_CACHE_VERSION=86400
# 默认缓存 TTL (默认 5 分钟)
CACHE_TTL_DEFAULT=300
# MxCAD 缓存 TTL (默认 5 分钟)
CACHE_TTL_MXCAD=300
# 权限缓存 TTL (默认 5 分钟)
CACHE_TTL_PERMISSION=300
# 策略缓存 TTL (默认 10 分钟)
CACHE_TTL_POLICY=600

# ============================================
# 文件扩展名配置 (逗号分隔)
# ============================================

# CAD 文件扩展名
FILE_EXT_CAD=.dwg,.dxf
# 图片文件扩展名
FILE_EXT_IMAGE=.png,.jpg,.jpeg,.gif,.bmp,.svg,.webp
# 文档文件扩展名
FILE_EXT_DOCUMENT=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt
# 压缩文件扩展名
FILE_EXT_ARCHIVE=.zip,.rar,.7z,.tar,.gz
# 字体文件扩展名
FILE_EXT_FONT=.ttf,.otf,.woff,.woff2,.eot,.shx
# 禁止上传的扩展名
FILE_EXT_FORBIDDEN=.exe,.bat,.sh,.cmd,.ps1,.scr,.vbs

# ============================================
# 文件限制配置
# ============================================

# ZIP 解压最大总大小 (字节，默认 2GB)
FILE_LIMIT_ZIP_MAX_TOTAL_SIZE=2147483648
# ZIP 解压最大文件数
FILE_LIMIT_ZIP_MAX_FILE_COUNT=10000
# ZIP 解压最大深度
FILE_LIMIT_ZIP_MAX_DEPTH=50
# ZIP 解压单文件最大大小 (字节，默认 500MB)
FILE_LIMIT_ZIP_MAX_SINGLE_FILE_SIZE=524288000
# ZIP 压缩级别 (1-9)
FILE_LIMIT_ZIP_COMPRESSION_LEVEL=1
# 最大文件名长度
FILE_LIMIT_MAX_FILENAME_LENGTH=255
# 最大路径长度
FILE_LIMIT_MAX_PATH_LENGTH=1024
# 最大目录深度
FILE_LIMIT_MAX_DIRECTORY_DEPTH=10
# 最大递归深度
FILE_LIMIT_MAX_RECURSION_DEPTH=50
# 角色继承最大深度
FILE_LIMIT_MAX_HIERARCHY_DEPTH=50

# ============================================
# 分页配置
# ============================================

# 默认页大小
PAGINATION_DEFAULT_PAGE_SIZE=50
# 最大页大小
PAGINATION_MAX_PAGE_SIZE=100

# ============================================
# 超时配置 (毫秒)
# ============================================

# 文件转换超时
TIMEOUT_FILE_CONVERSION=60000
# 分布式锁超时
TIMEOUT_DISTRIBUTED_LOCK=5000
# 请求限流超时
TIMEOUT_RATE_LIMITER=600000
# 目录分配节点限制超时
TIMEOUT_DIRECTORY_ALLOCATOR=300000

# ============================================
# 产品信息配置
# ============================================

# 产品名称
PRODUCT_NAME=CloudCAD
# 默认发件人
PRODUCT_DEFAULT_SENDER=CloudCAD <noreply@cloudcad.com>

# ============================================
# 缓存预热配置
# ============================================

# 最大预热用户数
CACHE_WARMUP_MAX_USERS=100
# 最大预热项目数
CACHE_WARMUP_MAX_PROJECTS=50

# ============================================
# 文件锁配置
# ============================================

# 锁超时时间 (毫秒，默认 5 分钟)
FILE_LOCK_TIMEOUT=300000
# 获取锁重试间隔 (毫秒)
FILE_LOCK_RETRY_INTERVAL=100
# 最大重试次数
FILE_LOCK_MAX_RETRIES=3

# ============================================
# 微信登录配置
# ============================================
# 注意：微信登录开关（wechatEnabled）已迁移到运行时配置系统
# 可在管理界面动态开启/关闭，无需重启服务

# 微信开放平台 AppID (网站应用)
# 申请地址: https://open.weixin.qq.com/
WECHAT_APP_ID=your_wechat_app_id

# 微信开放平台 packagesecret
WECHAT_APP_SECRET=your_wechat_app_secret

# 微信授权回调地址
# 格式: https://yourdomain.com/api/auth/wechat/callback
# 开发环境: http://localhost:3001/api/auth/wechat/callback
WECHAT_CALLBACK_URL=http://localhost:3001/api/auth/wechat/callback

# ============================================
# 邮件服务配置
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=CloudCAD <your-email@gmail.com>

# ============================================
# 监控抓取令牌配置（#315）
# ============================================
# Prometheus 抓取 /api/metrics 的 Bearer Token（等保 8.5.4 c 监控数据访问控制）：
#   - 配置后：请求带 `Authorization: Bearer <SCRAPE_TOKEN>` 或 Basic 认证
#     （密码字段=令牌，用户名任意）即可访问 /api/metrics，无需用户登录；
#     需与 docker/monitoring 监控栈的 SCRAPE_TOKEN 保持一致
#   - 未配置（默认空）：保持原有行为，/api/metrics 需 SYSTEM_MONITOR 权限的用户凭据
# 生成建议：openssl rand -hex 32
SCRAPE_TOKEN=

# ============================================
# 短信服务配置
# ============================================
# 注意：短信服务开关（smsEnabled）已迁移到运行时配置系统
# 可在管理界面动态开启/关闭，无需重启服务

# 短信服务商选择 (aliyun | tencent | mock)
# mock 模式仅输出日志，不发送真实短信，用于开发测试
SMS_PROVIDER=mock

# --------------------------------------------
# 阿里云短信配置
# 文档: https://help.aliyun.com/zh/sms/
# --------------------------------------------
# 阿里云 AccessKey ID
ALIYUN_ACCESS_KEY_ID=
# 阿里云 AccessKey Secret
ALIYUN_ACCESS_KEY_SECRET=
# 短信签名名称 (需要在阿里云控制台申请)
ALIYUN_SMS_SIGN_NAME=
# 验证码短信模板ID
ALIYUN_SMS_TEMPLATE_CODE=
# 地域ID (可选，默认 cn-hangzhou)
ALIYUN_SMS_REGION_ID=cn-hangzhou

# --------------------------------------------
# 腾讯云短信配置
# 文档: https://cloud.tencent.com/document/api/382/55981
# --------------------------------------------
# 腾讯云 SecretId
TENCENT_SECRET_ID=
# 腾讯云 SecretKey
TENCENT_SECRET_KEY=
# 短信应用ID (SdkAppId)
TENCENT_SMS_APP_ID=
# 短信签名名称
TENCENT_SMS_SIGN_NAME=
# 验证码短信模板ID
TENCENT_SMS_TEMPLATE_ID=
# 地域 (可选，默认 ap-guangzhou)
TENCENT_SMS_REGION=ap-guangzhou

# --------------------------------------------
# 短信验证码配置
# --------------------------------------------
# 验证码有效期 (秒，默认 5 分钟)
SMS_CODE_TTL=300
# 发送频率限制 (秒，默认 60 秒)
SMS_RATE_LIMIT_TTL=60

# --------------------------------------------
# 短信发送安全限制
# --------------------------------------------
# 每个手机号每日发送上限 (默认 10 次)
# 防止恶意刷短信扣费
SMS_DAILY_LIMIT_PER_PHONE=10
# 每个 IP 每小时发送上限 (默认 20 次)
# 防止多手机号攻击
SMS_HOURLY_LIMIT_PER_IP=20

# ============================================
# 日志配置 (ADR-0055 §1)
# ============================================
# 日志根目录（相对路径基于项目根解析，默认 data/logs）
LOG_DIR=data/logs
# 应用/访问日志保留天数（pino-roll 按天轮转，默认 180 天）
LOG_RETENTION_DAYS=180
# 访问日志开关（默认开启；false 关闭，等保 8.3.5.1/2 网络访问行为审计依赖此日志）
LOG_ACCESS_ENABLED=true
# 慢查询日志阈值（毫秒，仅开发环境生效，默认 500）
LOG_SLOW_QUERY_THRESHOLD_MS=500
# 注：日志文件权限依赖进程 umask，生产建议 umask 027（文件 0640 / 目录 0750）
# 后端已幂等创建日志目录（mode 0750）

# ============================================
# 缩略图配置
# ============================================

# MxWebDwg2Jpg 转换程序路径 (用于将 mxweb 转换为 jpg 缩略图)
# Windows 示例: runtime/windows/mxcad/tool/MxWebDwg2Jpg.exe
# Linux 示例: runtime/linux/mxcad/tool/MxWebDwg2Jpg
# Linux 上配置了 .exe 路径会自动回退到平台默认路径
# MXCAD_DWG2JPG_PATH=runtime/windows/mxcad/tool/MxWebDwg2Jpg.exe

# 是否启用后端自动生成缩略图 (true/false，默认 true)
# THUMBNAIL_AUTO_GENERATE_ENABLED=true

# 缩略图宽度 (像素，默认 300)
# THUMBNAIL_WIDTH=300

# 缩略图高度 (像素，默认 300 如果是0 表示自动计算保持原始宽高比)
# THUMBNAIL_HEIGHT=300

# 缩略图背景颜色 (十六进制 RGB 格式，默认黑色)
# THUMBNAIL_BACKGROUND_COLOR=0x000000

# ============================================
# 初始管理员账户 (仅在首次启动时创建)
# ============================================

INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin123!

# ============================================
# 支付 / 会员配置
# ============================================

# 支付提供商 (mock | wechat_pay，默认 mock)
# PAYMENT_PROVIDER=mock

# 微信支付（V2，仅在 PAYMENT_PROVIDER=wechat_pay 时必填）
# WECHATPAY_APPID=wx3d2a3968ed0e6bda
# WECHATPAY_MCHID=1446619502
# WECHATPAY_KEY=your_wechat_pay_key
# WECHATPAY_NOTIFY_URL=https://your-domain.com/api/billing/webhook/wechat

# 微信支付证书（退款等敏感操作需要 mTLS）
# PEM 格式（推荐）：cert + key 分开
WECHATPAY_CERT_PATH=data/certs/wechat/apiclient_cert.pem
WECHATPAY_KEY_PATH=data/certs/wechat/apiclient_key.pem
# PFX 格式（备选）：证书 + 私钥打包在一个文件里
# WECHATPAY_CERT_PATH=data/certs/wechat/apiclient_cert.p12

# ============================================
# 审计日志配置
# ============================================

# 审计日志保留天数 (默认 180 天，#207/ADR-0045；旧变量 AUDIT_RETENTION_DAYS 仍兼容回退)
AUDIT_LOG_RETENTION_DAYS=180

# 后台任务执行记录（TaskRun）保留天数 (默认 30 天，#271 无界增长治理，随审计清理 cron 每日执行)
TASK_RUN_RETENTION_DAYS=30

# 归档未实现（#223 fail-closed 决议）：归档功能尚未开发，
# 置为 true 时清理任务仅告警并跳过删除（日志零丢失），不会产生任何归档产物。
# 真归档将复用 #207 阶段 2 导出链路。默认 false 时行为不变（直接按保留天数删除）。
AUDIT_ARCHIVE_ENABLED=false

# 归档文件存储路径（预留；当前归档未实现，不影响行为）
AUDIT_ARCHIVE_PATH=data/archives/audit-logs

# ============================================
# 管理员登录 IP 白名单（管理员独立入口 /admin/auth/login）
# ============================================
# 本地白名单文件路径（兜底通道）：
#   - 相对路径基于项目根目录；也可用绝对路径。
#   - 文件格式：JSON（{"ips":["1.2.3.4","10.0.0.0/8"]} 或纯数组）或每行一个 IP/CIDR 的纯文本（# 注释）。
#   - 兜底语义：管理员在管理界面误删自己的 IP 白名单后，可在服务器上直接编辑此文件
#     加入自己的 IP 即可恢复登录（默认还恒放行 127.0.0.1/::1 本机环回）。
ADMIN_IP_WHITELIST_FILE=config/admin-ip-whitelist.json
# 可信反向代理地址段（反代部署时配置代理 IP，逗号分隔，支持精确 IP/CIDR）：
#   - 白名单判定基于不可伪造的真实连接地址（req.socket.remoteAddress）；
#   - 仅当真实对端命中本配置（= 受信代理）时，才信任 X-Forwarded-For 最右侧
#     地址（该地址由可信代理追加，客户端伪造的最左侧项不影响）。
#   - 直连部署（无反向代理）无需配置，默认取真实对端地址，客户端伪造 XFF 无效。
ADMIN_TRUSTED_PROXY_IPS=127.0.0.1,::1

# ============================================
# 速率限制配置
# ============================================
# 窗口期 (毫秒)，公开接口和认证接口共用此窗口
RATE_LIMIT_WINDOW_MS=60000
# 公开接口（@Public()）在窗口期内最大请求数
RATE_LIMIT_PUBLIC_MAX=100
# 认证接口（已登录用户）在窗口期内最大请求数
RATE_LIMIT_AUTH_MAX=300

# 登录相关接口（login/register/refresh/verify/forgot-password/send-verification 等）的窗口期（毫秒）
RATE_LIMIT_LOGIN_WINDOW_MS=60000
# 登录相关接口在窗口期内最大请求数（按 IP+路径+方法 独立计数）
RATE_LIMIT_LOGIN_MAX=50

# ============================================
# 账号维度限流配置（防撞库/暴力破解，与上述 IP 维度限流互补）
# 计数维度：邮箱 / 手机号 / 用户名；实现：Redis INCR + EXPIRE
# max 设为 0 可关闭对应维度的限流
# ============================================
# 登录尝试：次数上限 / 窗口（秒）/ 账号
AUTH_RATE_LIMIT_LOGIN_MAX=5
AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
# 密码找回：次数上限 / 窗口（秒）/ 账号
AUTH_RATE_LIMIT_PASSWORD_RESET_MAX=5
AUTH_RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=3600
# 注册：次数上限 / 窗口（秒）/ 账号
AUTH_RATE_LIMIT_REGISTER_MAX=5
AUTH_RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600