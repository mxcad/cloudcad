# 开发服务器端口（仅 dev server 用，非 VITE_ 前缀故不进 client bundle）
FRONTEND_PORT=8000

# 应用配置
VITE_APP_NAME=梦想网页CAD实时协同平台
VITE_APP_LOGO=/brand/logo.png

# API 基础路径：必须是同源相对路径。离线部署由前端 :8000 静态服务代理 /api 到后端，
# 写成绝对 http://localhost:3001/api 会变成跨域直连、浏览器丢 auth_token cookie，
# 协同接口恒 401。本文件不进 gitignore，但 Vite 只读 .env / .env.local ——
# 缺文件时代码兜底（apiConfig.ts）也必须是 /api，两道都要守住。
VITE_API_BASE_URL=/api

# 协同服务入口：经后端 /api/cooperate 反代到协同服务，勿写成 3091 端口直连
VITE_APP_COOPERATE_URL=/api/cooperate

# 可选：前端 Sentry DSN（不设置则前端不上报错误）
# VITE_SENTRY_DSN=https://...

# 可选：仅测试环境用，注入 MSW mock worker；生产保持不设置
# VITE_MSW=true

# 会员/支付开关（关闭时不显示会员相关界面）
VITE_MEMBERSHIP_ENABLED=false

# 管理员登录入口路径（防猜测，建议生产环境改为复杂难记路径）
# 示例: VITE_ADMIN_LOGIN_PATH=/u7x9k2-admin-secure-login
# 普通登录页不暴露管理员入口，只有知道该路径的人才能访问管理员登录。
VITE_ADMIN_LOGIN_PATH=/admin-login

# 桌面应用配置 (通过 URL 参数 ?id=xxx 匹配)
# 格式: VITE_APP_{ID}_TITLE 和 VITE_APP_{ID}_TAGLINE
# 示例: VITE_APP_CADVIEW_TITLE=CADView  VITE_APP_CADVIEW_TAGLINE=专业云端 CAD 图纸查看器
VITE_APP_CADVIEW_TITLE=CADView
VITE_APP_CADVIEW_TAGLINE=专业 CAD 图纸查看器
VITE_APP_MXCADWEB_TITLE=CAD梦想画图
VITE_APP_MXCADWEB_TAGLINE=专业CAD 图纸编辑器
