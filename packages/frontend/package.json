{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:msw": "msw-auto-mock ../../swagger_json.json -o src/test/msw/generated --typescript",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "check": "pnpm lint && pnpm format:check && pnpm depcruise",
    "check:fix": "pnpm lint:fix && pnpm format",
    "type-check": "tsc --noEmit",
    "i18n:init": "voerkai18n init",
    "i18n:extract": "voerkai18n extract",
    "i18n:compile": "voerkai18n compile -t",
    "i18nAutoTranslate": "voerkai18n translate --api baidu --provider baidu",
    "i18nAutoTranslateAi": "voerkai18n translate --api qwen",
    "i18n": "pnpm i18n:extract && pnpm i18nAutoTranslate && pnpm i18n:compile",
    "iconReplace": "node scripts/iconReplace.cjs"
  },
  "voerkai18n": {
    "namespaces": {
      "default": "messages"
    },
    "patterns": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "src/**/*.json",
      "!src/**/*.d.ts",
      "!dist",
      "!.vscode",
      "!public",
      "!scripts",
      "!node_modules",
      "!coverage"
    ]
  },
  "dependencies": {
    "@cloudcad/api-sdk": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/react": "^10.68.0",
    "@tanstack/react-query": "^5.100.9",
    "@voerkai18n/formatters": "^3.0.22",
    "@voerkai18n/react": "^3.0.12",
    "@voerkai18n/runtime": "^3.0.12",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.556.0",
    "mxcad-app": "^1.0.83",
    "openapi-client-axios": "^7.5.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.1",
    "react-day-picker": "^9.14.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.68.0",
    "react-horizontal-scrolling": "^0.1.13",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.5.1",
    "spark-md5": "^3.0.2",
    "tailwind-merge": "^3.4.0",
    "webuploader": "^0.1.8",
    "zod": "^4.2.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@msw/source": "^0.6.1",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/spark-md5": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^4.0.16",
    "@voerkai18n/cli": "3.0.12",
    "@voerkai18n/plugins": "3.0.12",
    "autoprefixer": "^10.4.23",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "happy-dom": "^20.10.6",
    "jsdom": "^27.3.0",
    "msw": "^2.14.3",
    "msw-auto-mock": "^0.32.1",
    "openapicmd": "^2.9.2",
    "postcss": "^8.5.26",
    "prettier": "^3.2.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.0.16"
  }
}
