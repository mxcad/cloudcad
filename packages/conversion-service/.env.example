# conversion-service 环境变量模板
# 复制为 .env 并填入真实值（.env 已 gitignore）。
# 本服务通过 lib/env.ts 预加载 .env / .env.local（真实 process.env 优先）。

# 队列驱动：
#   redis = 任务队列持久化到 Redis（跨重启/多节点）
#   local = 仅内存（默认；重启丢队列）
QUEUE_DRIVER=redis

# 带密码的 Redis 连接串，须与 backend 的 .env（REDIS_HOST/PORT/PASSWORD/DB）指向同一实例。
# 格式：redis://[:密码@]host:端口/库；无密码则省略 :密码@
REDIS_URL=redis://:your-redis-password@127.0.0.1:6379/0

# 服务端口（默认 3100）
# CONVERSION_SERVICE_PORT=3100

# 批量转换等管理类路由的共享密钥（后端调用方带 X-Conversion-Service-Secret 头）
# 未配置时跳过校验（本地开发/内网部署向后兼容）
# CONVERSION_SERVICE_SECRET=

# #419 等保 8.1.2.2：内部服务统一共享密钥（后端带 X-Internal-Service-Secret 头）
# 与 CONVERSION_SERVICE_SECRET 任一匹配即放行；两者均未配置时跳过校验
# INTERNAL_SERVICE_SECRET=

# 鉴权门禁：两密钥均未配置时是否拒绝请求。默认随环境（NODE_ENV=production→true 防生产裸奔，
# 其他→false 本地/内网向后兼容）。显式 true/false 可覆盖（内网想强制门禁设 true，本地调试放宽设 false）
# CONVERSION_SERVICE_REQUIRE_AUTH=
