logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Environment
# 排除所有环境文件（含子目录），但保留 .env.example 模板
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Deploy lock hash (记录已安装的依赖版本，不应提�?
.deploy-lock-hash

# Generated files
**/swagger_json.json

# Data directory (all user data)
data/

# 保留外置配置目录结构 (用户配置文件不提�?
!data/configs/.gitkeep
!data/configs/frontend/.gitkeep
!data/configs/frontend/ini/.gitkeep
!data/configs/frontend/brand/.gitkeep

# Temporary/debug files
*.bak
*.bak[0-9]
*.stackdump
*-errors.txt
*-warnings.txt
docker-build-*.txt
config-service-login.jpg


