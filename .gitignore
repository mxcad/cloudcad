.claude/commands/
.claude/worktrees/
# CodeBuddy 本地数据（plans/settings 等，保留文件夹但不入库）
.codebuddy/
.qwen/
runtime/cache/

# Git worktrees
.worktrees/
temp.claude/worktrees/
.gitnexus

# Playwright MCP artifacts
.playwright-mcp/

# SVN
.svn/

# Temporary deploy artifacts
temp/

# User uploaded files (prevent accidental tracking)
uploads/

