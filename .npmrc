store-dir=./.pnpm-store
registry=https://registry.npmjs.org/
strict-ssl=true
# ── 依赖稳定性（2026-09-30 审计）─────────────────────────────────────────
# prefer-offline：store 命中时完全不碰网络，不做新鲜度探测——因此 registry 上
#   出了新版本也不会触发升级；只有 store 缺失时才回退联网（"下载一次，之后全用
#   本地缓存"）。不加这条时 pnpm 会对部分元数据联网探测，弱网下既慢又不稳定。
prefer-offline=true
# 弱网重试（默认 3 次 / 退避上限 60s → 5 次 / 上限 120s）：打包机偶发网络抖动
#   不再导致 install 半途失败。缓存命中时不生效，不影响离线安装速度。
fetch-retries=5
fetch-retry-maxtimeout=120000
