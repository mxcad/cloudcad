{
  "name": "cloudcad",
  "version": "1.0.0",
  "description": "CloudCAD monorepo",
  "private": true,
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "dependency-cruiser": "^16.10.4",
    "effect": "^3.19.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "prettier": "^3.2.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "preinstall": "node scripts/ensure-runtime.js",
    "build": "pnpm -r build",
    "postbuild": "pnpm generate:api-types",
    "predev": "pnpm --filter @cloudcad/db build",
    "dev": "pnpm -r dev",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm type-check",
    "depcruise": "cd packages/backend && depcruise src --config .dependency-cruiser.js",
    "check:fix": "pnpm lint:fix && pnpm format",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r clean",
    "cooperate": "node runtime/scripts/cooperate-manager.js",
    "generate:frontend-permissions": "node scripts/generate-frontend-permissions.js",
    "generate:api-types": "pnpm --filter @cloudcad/api-sdk generate:sdk",
    "reinstall:node-tools": "node scripts/reinstall-node-tools.js",
    "pack:offline": "node scripts/pack-offline.js --deploy",
    "pack:offline:private": "node scripts/pack-offline.js --deploy --variant private",
    "pack:offline:win": "node scripts/pack-offline.js --win --deploy",
    "pack:offline:linux": "node scripts/pack-offline.js --linux --deploy",
    "pack:offline:all": "node scripts/pack-offline.js --all",
    "pack:docker": "node scripts/pack-docker.js",
    "pack:linux-deploy": "node scripts/pack-linux-deploy.js",
    "pack:linux-deploy:private": "node scripts/pack-linux-deploy.js --variant private",
    "pack:linux-deploy:ubuntu22": "node scripts/pack-linux-deploy.js --os ubuntu22",
    "pack:linux-deploy:ubuntu24": "node scripts/pack-linux-deploy.js --os ubuntu24",
    "pack:linux-deploy:rocky9": "node scripts/pack-linux-deploy.js --os rocky9",
    "pack:linux-local": "bash scripts/pack-linux-local.sh",
    "verify:linux": "node scripts/verify-linux-deploy.js",
    "verify:linux:debian": "node scripts/verify-linux-deploy.js --os debian",
    "verify:linux:ubuntu22": "node scripts/verify-linux-deploy.js --os ubuntu22",
    "verify:linux:ubuntu24": "node scripts/verify-linux-deploy.js --os ubuntu24",
    "verify:linux:centos7": "node scripts/verify-linux-deploy.js --os centos7",
    "verify:linux:rocky8": "node scripts/verify-linux-deploy.js --os rocky8",
    "verify:linux:rocky9": "node scripts/verify-linux-deploy.js --os rocky9",
    "deploy": "docker-compose -f docker/docker-compose.yml --env-file docker/.env up -d --build",
    "deploy:down": "docker-compose -f docker/docker-compose.yml down",
    "deploy:reset": "docker-compose -f docker/docker-compose.yml down -v",
    "deploy:logs": "docker-compose -f docker/docker-compose.yml logs -f",
    "deploy:rebuild": "docker-compose -f docker/docker-compose.yml build --no-cache",
    "init-dotagents": "npx @iannuttall/dotagents",
    "pack:upgrade": "node scripts/pack-offline.js --upgrade",
    "pack:upgrade:win": "node scripts/pack-offline.js --upgrade --win",
    "pack:upgrade:linux": "node scripts/pack-offline.js --upgrade --linux",
    "pack:upgrade:win:private": "node scripts/pack-offline.js --upgrade --win --variant private",
    "pack:upgrade:linux:private": "node scripts/pack-offline.js --upgrade --linux --variant private",
    "pack:linux-upgrade": "node scripts/pack-linux-deploy.js --upgrade",
    "pack:linux-upgrade:private": "node scripts/pack-linux-deploy.js --upgrade --variant private",
    "pack:linux-upgrade:ubuntu22": "node scripts/pack-linux-deploy.js --upgrade --os ubuntu22",
    "pack:linux-upgrade:ubuntu22:private": "node scripts/pack-linux-deploy.js --upgrade --os ubuntu22 --variant private",
    "pack:linux-upgrade:ubuntu24": "node scripts/pack-linux-deploy.js --upgrade --os ubuntu24",
    "pack:linux-upgrade:centos7": "node scripts/pack-linux-deploy.js --upgrade --os centos7",
    "pack:linux-upgrade:rocky9": "node scripts/pack-linux-deploy.js --upgrade --os rocky9",
    "pack:linux-upgrade:ubuntu24:private": "node scripts/pack-linux-deploy.js --upgrade --os ubuntu24 --variant private",
    "pack:linux-upgrade:centos7:private": "node scripts/pack-linux-deploy.js --upgrade --os centos7 --variant private",
    "pack:linux-upgrade:rocky9:private": "node scripts/pack-linux-deploy.js --upgrade --os rocky9 --variant private",
    "pack:menu": "node scripts/pack-menu.js",
    "brand:check": "node scripts/sync-brand.js",
    "brand:sync": "node scripts/sync-brand.js --apply"
  },
  "engines": {
    "node": ">=20.19.5",
    "pnpm": ">=9.15.9"
  },
  "pnpm": {
    "overrides": {
      "art-template@4.13.7": "4.13.4"
    }
  },
  "packageManager": "pnpm@9.15.9"
}
