#!/bin/sh
# CloudCAD Secret Scanner — 预提交钩子
# 在 .gitignore 之外提供第二层防护，拦截敏感文件名和疑似密钥内容

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

[ -z "$STAGED" ] && exit 0

# ── 阶段 1: 文件名拦截 ─────────────────────
echo "$STAGED" | while IFS= read -r f; do
    [ -z "$f" ] && continue

    # 允许 .env.example / .env.docker
    case "$f" in
        *.env.example|*.env.docker) continue ;;
    esac

    case "$f" in
        *.env*)
            printf "${RED}❌ SECURITY: 环境变量文件被暂存: %s${NC}\n" "$f"
            printf "   ${YELLOW}如需绕过: git commit --no-verify${NC}\n"
            exit 1 ;;
        *test-login-data*|*test-credentials*|*credentials.json|*secrets.json|*credential.json)
            printf "${RED}❌ SECURITY: 疑似测试凭据文件: %s${NC}\n" "$f"
            exit 1 ;;
        */e2e/.auth/*|*.bak.*.json)
            printf "${RED}❌ SECURITY: 运行时产物不可提交: %s${NC}\n" "$f"
            exit 1 ;;
        *upload-progress.json|*thumbnail-progress.json|*upload-failed.log)
            printf "${RED}❌ SECURITY: 进度/日志文件不可提交: %s${NC}\n" "$f"
            exit 1 ;;
        */received-files/*|file-sync/*)
            printf "${RED}❌ SECURITY: 文件同步产物不可提交: %s${NC}\n" "$f"
            exit 1 ;;
    esac
done
[ $? -ne 0 ] && exit 1

# ── 阶段 2: 新文件内容扫描 ─────────────────
ADDED=$(git diff --cached --name-only --diff-filter=A)
echo "$ADDED" | while IFS= read -r f; do
    [ -z "$f" ] && continue

    case "$f" in
        *.json|*.yaml|*.yml)
            git show ":$f" 2>/dev/null | grep -qiE \
                '"(password|secret|apiKey|api_key|token|jwt|private_key)"[[:space:]]*:[[:space:]]*"' && {
                printf "${YELLOW}⚠️  SECURITY: 文件 %s 含疑似密钥字段${NC}\n" "$f"
                printf "   ${YELLOW}请确认无真实凭据，如需绕过: git commit --no-verify${NC}\n"
                exit 1
            } || true ;;
    esac
done

exit 0
